+// The file is a versioned copy of tensor data, not device pointers or GGML graphs.
+// Reading and writing through a shared 1 MiB staging buffer keeps the disk tier bounded.
+constexpr uint64_t max_prefix_blob = 512ULL * 1024 * 1024;
+constexpr std::array<char, 8> prefix_magic = {'D','R','3','P','F','X','1','\0'};
+
+class PrefixFile {
+public:
+    PrefixFile(const std::filesystem::path & path, bool writing)
+        : stream_(path, std::ios::binary | (writing ? std::ios::out | std::ios::trunc : std::ios::in)),
+          writing_(writing) {}
+
+    bool transfer(void * data, size_t size) {
+        auto * bytes = static_cast<char *>(data);
+        if (writing_) stream_.write(bytes, static_cast<std::streamsize>(size));
+        else stream_.read(bytes, static_cast<std::streamsize>(size));
+        if (!stream_) return false;
+        for (size_t i = 0; i < size; ++i) {
+            checksum_ ^= static_cast<unsigned char>(bytes[i]);
+            checksum_ *= 1099511628211ULL;
+        }
+        return true;
+    }
+
+    bool complete() {
+        if (writing_) {
+            stream_.write(reinterpret_cast<const char *>(&checksum_), sizeof(checksum_));
+            stream_.flush();
+            return static_cast<bool>(stream_);
+        }
+        uint64_t check = 0;
+        stream_.read(reinterpret_cast<char *>(&check), sizeof(check));
+        return stream_ && check == checksum_ && stream_.peek() == std::char_traits<char>::eof();
+    }
+
+private:
+    std::fstream stream_;
+    bool writing_;
+    uint64_t checksum_ = 14695981039346656037ULL;
+};
+
+uint64_t prefix_blob_size(Drama3BackboneDecoderRuntime::DecodeSession & decoder,
+    size_t rows, size_t hidden_size) {
+    uint64_t size = prefix_magic.size() + 64 + 2 * sizeof(uint64_t) + sizeof(uint64_t)
+        + rows * (sizeof(Drama3Frame) + hidden_size * sizeof(float));
+    if (!decoder.visit_prefix_state(static_cast<int64_t>(rows), [&](ggml_tensor *, size_t bytes) {
+            if (bytes > max_prefix_blob || size > max_prefix_blob - bytes) return false;
+            size += bytes;
+            return true;
+        })) return 0;
+    return size;
+}
