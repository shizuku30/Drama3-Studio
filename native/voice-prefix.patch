+    try {
+        const auto path = std::filesystem::u8path(name);
+        if (writing ? path.extension() != ".pending" : path.extension() != ".prefix") return false;
+        if (!writing) {
+            std::error_code error;
+            if (std::filesystem::file_size(path, error) != size || error) return false;
+        }
+        PrefixFile file(path, writing);
+        auto magic = prefix_magic;
